{
  "name": "image-tools-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:server": "tsx server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "next build",
    "build:server": "tsc --project tsconfig.server.json",
    "build:pages": "next build && node -e \"require('fs').cpSync('out','dist',{recursive:true})\"",
    "start": "next start",
    "start:server": "node dist/server/index.js",
    "lint": "next lint",
    "fix": "next lint --fix",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@types/xlsx": "^0.0.35",
    "browser-image-compression": "^2.0.2",
    "canvas": "^3.2.1",
    "clsx": "^2.1.1",
    "express": "^4.18.2",
    "framer-motion": "^12.39.0",
    "lucide-react": "^0.542.0",
    "markdown-it": "^14.1.1",
    "multer": "^1.4.5-lts.1",
    "next": "^14.2.33",
    "pdf-lib": "^1.17.1",
    "png-to-ico": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swiper": "^12.1.2",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.0",
    "@types/express": "^4.17.21",
    "@types/markdown-it": "^14.1.2",
    "@types/multer": "^1.4.11",
    "@types/node": "25.5.0",
    "@types/react": "^18.3.24",
    "autoprefixer": "^10.4.27",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.33",
    "eslint-plugin-unused-imports": "^4.4.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5.9.2"
  }
}
